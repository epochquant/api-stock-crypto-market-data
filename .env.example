# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000

# ─── Security ─────────────────────────────────────────────────────────────────
# Required. Clients must send this in the x-api-key header for protected routes.
API_KEY=your-secret-api-key-here

# ─── Binance (public endpoints — no key needed for candles/ticker) ────────────
BINANCE_BASE_URL=https://api.binance.com
# Optional — only needed if authenticated endpoints (balances, orders) are added later.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# ─── Alpaca Market Data ────────────────────────────────────────────────────────
ALPACA_BASE_URL=https://data.alpaca.markets
ALPACA_API_KEY_ID=your-alpaca-api-key-id
ALPACA_API_SECRET_KEY=your-alpaca-api-secret-key

# ─── Yahoo Finance ─────────────────────────────────────────────────────────────
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
